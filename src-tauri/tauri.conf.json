{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intervjuare",
  "version": "0.1.0",
  "identifier": "com.rafal.intervjuare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Intervjuare",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "externalBin": ["intervjuare-macos-bridge"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "target/debug/intervjuare-runtime/*": ""
    }
  }
}
